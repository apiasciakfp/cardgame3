{
    "name": "cardmultigame/cardmultigame",
    "description": "Faithful surface-idiomatic PHP port of CardMultigame (C# design-patterns showcase)",
    "type": "project",
    "license": "AGPL-3.0-only",
    "require": {
        "php": ">=8.3",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "CardMultigame\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CardMultigame\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
